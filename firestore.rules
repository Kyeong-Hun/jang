rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function validBox(b) {
      return b is map
        && b.keys().hasAll(['iv', 'ciphertext'])
        && b.keys().hasOnly(['iv', 'ciphertext'])
        && b.iv is string
        && b.iv.size() >= 16 && b.iv.size() <= 32
        && b.ciphertext is string
        && b.ciphertext.size() > 20 && b.ciphertext.size() < 900000;
    }

    function validKdf(k) {
      return k is map
        && k.keys().hasAll(['name', 'salt', 'iterations'])
        && k.keys().hasOnly(['name', 'salt', 'iterations'])
        && k.name == 'PBKDF2-SHA256'
        && k.salt is string && k.salt.size() >= 20 && k.salt.size() <= 40
        && k.iterations == 600000;
    }

    function validPending(p) {
      return p is map
        && p.keys().hasAll(['kdf', 'passwordWrap'])
        && p.keys().hasOnly(['kdf', 'passwordWrap'])
        && validKdf(p.kdf) && validBox(p.passwordWrap);
    }

    function validEncryptedState() {
      let d = request.resource.data;
      let v = d.vault;
      return d.keys().hasAll(['schemaVersion', 'vault', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'vault', 'updatedAt'])
        && d.schemaVersion == 2
        && d.updatedAt is timestamp
        && v is map
        && v.keys().hasAll(['version', 'kdf', 'passwordWrap', 'recoverySalt', 'recoveryWrap', 'data'])
        && v.keys().hasOnly(['version', 'kdf', 'passwordWrap', 'recoverySalt', 'recoveryWrap', 'data', 'pendingPassword'])
        && v.version == 1
        && validKdf(v.kdf)
        && validBox(v.passwordWrap)
        && v.recoverySalt is string && v.recoverySalt.size() >= 20 && v.recoverySalt.size() <= 40
        && validBox(v.recoveryWrap)
        && validBox(v.data)
        && (!('pendingPassword' in v) || validPending(v.pendingPassword));
    }

    match /users/{uid}/private/{documentId} {
      allow get: if documentId == 'state' && isOwner(uid);
      allow list: if false;
      // These encrypted health record rules are unchanged from the repository.
      allow create: if documentId == 'state' && isOwner(uid) && validEncryptedState();
      allow update: if documentId == 'state' && isOwner(uid)
        && resource.data.schemaVersion in [1, 2]
        && validEncryptedState();
      allow delete: if documentId == 'state' && isOwner(uid);
    }

    function supportUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function primaryAdmin() {
      return supportUser()
        && request.auth.token.email == 'louis1004kkh@gmail.com';
    }

    match /adminSecurity/{configId} {
      allow read, write: if false;
    }

    match /adminSessions/{uid} {
      allow get, list: if false;
      allow create, update: if primaryAdmin()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/adminSecurity/config)
        && request.resource.data.keys().hasAll(['proof', 'authTime', 'unlockedAt'])
        && request.resource.data.keys().hasOnly(['proof', 'authTime', 'unlockedAt'])
        && request.resource.data.proof is string
        && request.resource.data.proof.size() == 64
        && request.resource.data.proof == get(/databases/$(database)/documents/adminSecurity/config).data.passwordVerifier
        && request.resource.data.authTime == request.auth.token.auth_time
        && request.resource.data.unlockedAt == request.time;
      allow delete: if primaryAdmin() && request.auth.uid == uid;
    }

    function supportAdmin() {
      return primaryAdmin()
        && exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time
        && get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.proof ==
           get(/databases/$(database)/documents/adminSecurity/config).data.passwordVerifier;
    }

    function ticketOwner(ticketId) {
      return supportUser()
        && exists(/databases/$(database)/documents/supportTickets/$(ticketId))
        && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.ownerUid == request.auth.uid;
    }

    match /supportTickets/{ticketId} {
      allow create: if supportUser()
        && request.resource.data.keys().hasAll(['ownerUid','email','category','subject','message','reply','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerUid','email','category','subject','message','reply','status','createdAt','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.category in ['bug','feature','account','other']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.reply == ''
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if supportAdmin() || (supportUser() && resource.data.ownerUid == request.auth.uid);
      allow list: if request.query.limit <= 100
        && (supportAdmin() || (supportUser() && resource.data.ownerUid == request.auth.uid));
      // Admin may answer; ticket owner may only reopen the ticket after posting.
      allow update: if (
        supportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','status','updatedAt'])
        && request.resource.data.reply is string
        && request.resource.data.reply.size() >= 1
        && request.resource.data.reply.size() <= 2000
        && request.resource.data.status == 'replied'
        && request.resource.data.updatedAt == request.time
      ) || (
        supportUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if supportAdmin() || ticketOwner(ticketId);
        allow list: if request.query.limit <= 100 && (supportAdmin() || ticketOwner(ticketId));
        allow create: if (supportAdmin() || ticketOwner(ticketId))
          && request.resource.data.keys().hasAll(['senderUid','senderRole','text','createdAt'])
          && request.resource.data.keys().hasOnly(['senderUid','senderRole','text','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderRole == (ticketOwner(ticketId) ? 'user' : 'admin')
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /publicContent/{contentType} {
      allow get: if contentType in ['help','releases'] && supportUser();
      allow list: if false;
      allow create, update: if contentType in ['help','releases'] && supportAdmin()
        && request.resource.data.keys().hasAll(['items','updatedBy','updatedAt'])
        && request.resource.data.keys().hasOnly(['items','updatedBy','updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 35
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
